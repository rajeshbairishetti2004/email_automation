# ================================
# PHP Client Reports System
# ================================

# ========== OS FILES ============
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
*~

# ========== IDE & EDITOR FILES ============
# VS Code
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json
*.code-workspace

# PHPStorm / IntelliJ
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace
sftp-config.json

# ========== PHP & COMPOSER ============
# Dependencies - vendor folder should not be committed
/vendor/
/composer.phar

# Composer cache
/.composer/cache/

# PHPUnit
/.phpunit.result.cache
/.phpunit.cache
phpunit.xml

# ========== ENVIRONMENT FILES ============
# Never commit environment files with secrets
.env
.env.*.local
.env.production
.env.staging
.env.development
!.env.example

# Local overrides
.env.local
.env.*.local.php

# ========== LOGS & RUNTIME ============
# Application logs
*.log
logs/
storage/logs/

# Cache files
*.cache
/.cache/
/tmp/
/temp/
/cache/

# Sessions
/sessions/

# ========== UPLOADED FILES ============
# User uploaded files (should not be in version control)
/uploads/
/public/uploads/
/storage/uploads/
!uploads/.gitkeep
/report_generation/extracted/

# ========== DATABASE ============
# Database files and dumps
*.sql
*.sqlite
*.sqlite3
*.db
/database/*.sqlite
/database/dumps/

# ========== TEST & COVERAGE ============
# PHPUnit
/coverage/
.phpunit.result.cache

# ========== SECURITY & CERTS ============
# SSL certificates and keys
*.pem
*.key
*.crt
*.csr
.ssh/

# Backup files
*.bak
*.backup
*.orig
*.save

# ========== NODE & FRONTEND ============
# Node modules (if using any frontend tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ========== MISC ============
# Backup files created by editors
*~
*.swp
*.swo

# Archives
*.zip
*.tar
*.gz
*.7z

# .gitignore
.env
/vendor
/uploads
/uploads
.DS_Store